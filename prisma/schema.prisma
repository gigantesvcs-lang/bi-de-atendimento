generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model fact_atendimentos {
  id                            Int       @id @default(autoincrement())
  conversation_id               Int?      @unique
  contato_nome                  String?   @db.VarChar(255)
  contato_fone                  String?   @db.VarChar(50)
  canal                         String?   @db.VarChar(50)
  origem                        String?   @db.VarChar(50)
  intent_principal              String?   @db.VarChar(50)
  sub_intent                    String?   @db.VarChar(50)
  time_responsavel              String?   @db.VarChar(100)
  status_conversa               String?   @db.VarChar(50)
  data_inicio                   DateTime? @db.Timestamp(6)
  data_primeira_resposta_humana DateTime? @db.Timestamp(6)
  data_fechamento               DateTime? @db.Timestamp(6)
  espera_segundos               Int?
  atendimento_segundos          Int?
  total_mensagens               Int?      @default(0)
  atualizado_em                 DateTime? @default(now()) @db.Timestamp(6)
}

model fact_menu_escolhas {
  id              Int       @id @default(autoincrement())
  conversation_id Int?
  etapa_menu      String?   @db.VarChar(100)
  opcao_escolhida String?   @db.VarChar(255)
  data_escolha    DateTime? @default(now()) @db.Timestamp(6)
}

model usuarios {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String    @db.VarChar(255)
  email      String    @unique @db.VarChar(255)
  senha_hash String    @db.VarChar(255)
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
}

model configuracoes {
  id               String    @id @default("global") @db.VarChar(50)
  ai_provider      String    @default("google") @db.VarChar(50)
  ai_model         String    @default("gemini-1.5-flash") @db.VarChar(100)
  ai_api_key       String?   @db.Text
  atualizado_em    DateTime? @default(now()) @db.Timestamp(6)
}
